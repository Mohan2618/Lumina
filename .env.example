# AI services
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key

Brevo SMTP
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_verified_sender_email@example.com
BREVO_FROM_NAME=Lumina

DATABASE_URL=your_supabase_postgresql_connection_string_here

# Flask
FLASK_SECRET_KEY=your_flask_api_key

# Image generation: Cloudflare Workers AI (free daily allocation; never commit real tokens)
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# Cloudflare FLUX.1-schnell supports 1-8 steps; 4 is a balanced default
IMAGE_GENERATION_STEPS=4
# Optional legacy provider (set IMAGE_PROVIDER=huggingface to use it instead)
HF_TOKEN=your_huggingface_token
IMAGE_GENERATION_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_GENERATION_GUIDANCE=0
