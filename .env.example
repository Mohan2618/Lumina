# AI services
GOOGLE_API_KEY=your_google_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Brevo SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_login_email
SMTP_PASSWORD=your_brevo_smtp_key
# Optional: use a verified Brevo sender address. If omitted, SMTP_USERNAME is used.
SMTP_FROM_EMAIL=your_verified_sender_email

# Flask
FLASK_SECRET_KEY=your_flask_secret_key

# Image generation: Cloudflare Workers AI (free daily allocation; never commit real tokens)
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_token
# Cloudflare FLUX.1-schnell supports 1-8 steps; 4 is a balanced default
IMAGE_GENERATION_STEPS=4
# Optional legacy provider (set IMAGE_PROVIDER=huggingface to use it instead)
HF_TOKEN=your_huggingface_token
IMAGE_GENERATION_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_GENERATION_GUIDANCE=0
