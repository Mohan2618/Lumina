# AI services
GOOGLE_API_KEY=your_google_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Brevo SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_login_email
SMTP_PASSWORD=your_brevo_smtp_key
# Optional: use a verified Brevo sender address. If omitted, SMTP_USERNAME is used.
SMTP_FROM_EMAIL=your_verified_sender_email

# Flask
FLASK_SECRET_KEY=your_flask_secret_key

# Image generation (configure real secrets in Render; never commit real tokens)
HF_TOKEN=your_huggingface_token
IMAGE_GENERATION_MODEL=black-forest-labs/FLUX.1-schnell
# FLUX.1-schnell recommended starting settings
IMAGE_GENERATION_STEPS=4
IMAGE_GENERATION_GUIDANCE=0
